# Gmail API (download credentials.json from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# OpenAI — required for AI extraction
OPENAI_API_KEY=

# Slack Bot
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#project-updates

# Email sending via Gmail SMTP
SENDER_EMAIL=
SENDER_PASSWORD=
REPORT_RECIPIENTS=

# Gmail search query — tune this to target your project update emails
GMAIL_QUERY=from:@yourcompany.com subject:update OR subject:status
GMAIL_MAX_RESULTS=20

# Database
DB_PATH=projects.db

# Automatic scanning (0 = disabled, manual only)
SCAN_INTERVAL_HOURS=0

# Flask — leave these as-is for production
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_PORT=5001
USE_MOCK_DATA=False
