# Gmail API (download credentials.json from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# OpenAI — required for AI extraction
OPENAI_API_KEY=

# Slack Bot
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#project-updates

# Email sending via Gmail SMTP
SENDER_EMAIL=
SENDER_PASSWORD=
REPORT_RECIPIENTS=

# Gmail search query — tune this to target your project update emails
GMAIL_QUERY=from:@yourcompany.com subject:update OR subject:status
GMAIL_MAX_RESULTS=20

# Database
DB_PATH=projects.db

# Automatic scanning — how often to check Gmail for new emails (minutes)
# 15 = check every 15 minutes (recommended); 0 = disable auto-scan
SCAN_INTERVAL_MINUTES=15

# Automatic report sending to email + Slack (0 = disabled, 24 = once per day)
REPORT_SEND_HOURS=24

# Flask — leave these as-is for production
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_PORT=5001
USE_MOCK_DATA=False
