# Gmail API (download from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json

# OpenAI for extraction
OPENAI_API_KEY=sk-...

# Slack Bot
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=#project-updates

# Email sending (Gmail SMTP)
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password
REPORT_RECIPIENTS=ujjwal@autonomize.ai,other@company.com

# Database
DB_PATH=projects.db

# Gmail Query Settings
GMAIL_QUERY=label:project-updates OR subject:project OR subject:update
GMAIL_MAX_RESULTS=10

# Development
FLASK_ENV=development
FLASK_DEBUG=True
USE_MOCK_DATA=True
